note tests/dispatch_trace.om: host trace of gsp/dispatch.om on the in-.om simulator.
note Reads cases on stdin, decimal:
note name busy budget core corefail perms gen_off tok_off bstate pkt_trunc nwords end m w0 .. w(m-1)
note Prints, per case, what tests/dispatch_ref.c prints for the C reference on the C simulator:
note == name rc=RC state=S dead=D why=WHY delays=CALLS/US core=CALLS ops=OP,.. save=%#x,..(8) nlog=N violations=N
note then the register log, one "W|R %06x %08x" line per access.
note Host only, mode 0 only. Never touches real hardware.
const LOGMAX ulong 1024
const M32 ulong 4294967295
text zqtx "== | rc=| state=| dead=| why=| delays=| core=| ops=| save=| nlog=| violations=|"
global zqin uchar 262144
global zqn ulong 1
global zqp ulong 1
global zqt uchar 64
global zqtl ulong 1
global zqnm uchar 64
global zqnml ulong 1
global zqob uchar 65536
global zqo ulong 1
global zqops ulong 16
global zqnop ulong 1
global zqfail ulong 1
global zqbusy ulong 1
global zqbud ulong 1
global zqcon ulong 1
global zqperm ulong 1
global zqgenoff ulong 1
global zqtokoff ulong 1
global zqistat ulong 1
global zqtrunc ulong 1
global zqmode ulong 1
global zqnw ulong 1
global zqci ulong 1
fn sqcorefn op ulong to long
k = get zqnop 0
if lt k 16
put zqops k op
end
put zqnop 0 add k 1
if eq op get zqfail 0
ret -1
end
ret 0
end
fn zqflush to void
n = get zqo 0
if eq n 0
ret
end
p = ulong 0
while lt p n bound 100000
w = write 1 zqob p sub n p
if le w 0
exit 1
end
p = add p ulong w
end
put zqo 0 0
end
fn zqbad to void
zqflush
exit 2
end
fn zqch c uchar to void
p = get zqo 0
put zqob p c
put zqo 0 add p 1
if ge add p 1 65000
zqflush
end
end
fn zqfr k ulong to void
w = ulong 0
for i ulong len zqtx
c = get zqtx i
if eq c 124
w = add w 1
else
if eq w k
zqch c
end
end
end
end
fn zqdec v ulong to void
d = ulong 1
while le d div v 10 bound 20
d = mul d 10
end
while ne d 0 bound 20
zqch uchar add rem div v d 10 48
d = div d 10
end
end
fn zqsdec v long to void
if lt v 0
zqch 45
zqdec ulong sub 0 v
else
zqdec ulong v
end
end
fn zqdig v ulong to void
if lt v 10
zqch uchar add v 48
else
zqch uchar add sub v 10 97
end
end
fn zqhexw v ulong w ulong to void
t = v
nd = ulong 0
while ne t 0 bound 17
nd = add nd 1
t = shr t 4
end
if lt nd w
nd = w
end
for i ulong nd
zqdig and shr v mul sub sub nd i 1 4 15
end
end
fn zqhex v ulong to void
if eq v 0
zqch 48
ret
end
zqch 48
zqch 120
zqhexw v 1
end
fn zqsp c uchar to bool
ret or eq c 32 and ge c 9 le c 13
end
fn zqtok to ulong
p = get zqp 0
n = get zqn 0
while and lt p n zqsp get zqin p bound 300000
p = add p 1
end
l = ulong 0
while and lt p n not zqsp get zqin p bound 300000
if ge l 63
zqbad
end
put zqt l get zqin p
l = add l 1
p = add p 1
end
put zqp 0 p
put zqtl 0 l
ret l
end
fn zqskipl to void
p = get zqp 0
n = get zqn 0
while and lt p n ne get zqin p 10 bound 300000
p = add p 1
end
put zqp 0 p
end
fn zqnum to ulong
l = zqtok
if eq l 0
zqbad
end
v = ulong 0
for i ulong l
c = get zqt i
if or lt c 48 gt c 57
zqbad
end
v = add mul v 10 ulong sub c 48
if gt v 4294967295
zqbad
end
end
ret v
end
fn zqexec to void
busy = get zqbusy 0
for i ulong 10
put scfg i 0
end
put scfg 0 busy
siminit
put spm 0 0
put gspmode 0 get zqmode 0
for j ulong SQSAVE
put sqsave j 0
end
put sqdly 0 0
put sqdly 1 0
put zqnop 0 0
put sqbud 0 get zqbud 0
put sqcore 0 get zqcon 0
dspinit
dspperms get zqperm 0
put bgen 0 42
put btoken 0 1001
put bprev 0 9
put bstate 0 get zqistat 0
put rqdead 0 0
nw = get zqnw 0
ci = get zqci 0
trunc = get zqtrunc 0
if eq trunc 1
put bselen 0 100
else
put bselen 0 add 120 mul nw 4
end
dspp32 80 nw
dspp32 84 ci
for k ulong SQSAVE
dspp32 add 88 mul k 4 0
end
gen = add 42 get zqgenoff 0
tok = add 1001 get zqtokoff 0
rc = dspseq gen tok
dspwhy rc
zqfr 0
for k ulong get zqnml 0
zqch get zqnm k
end
zqfr 1
zqsdec rc
zqfr 2
zqdec get bstate 0
zqfr 3
zqdec get rqdead 0
zqfr 4
if eq get dspwl 0 0
zqch 45
else
for k ulong get dspwl 0
zqch get dspwb k
end
end
zqfr 5
zqdec get sqdly 0
zqch 47
zqdec and get sqdly 1 M32
zqfr 6
zqdec get zqnop 0
zqfr 7
for k ulong get zqnop 0
if lt k 16
zqdec get zqops k
zqch 44
end
end
zqfr 8
for k ulong SQSAVE
zqhex dspu32 add 88 mul k 4
zqch 44
end
zqfr 9
zqdec sg SNLOG
zqfr 10
zqdec sg SVIOL
zqch 10
for k ulong sg SNLOG
if lt k LOGMAX
if eq get slogw k 1
zqch 87
else
zqch 82
end
zqch 32
zqhexw get slogo k 6
zqch 32
zqhexw get slogv k 8
zqch 10
end
end
end
fn main to int
p = ulong 0
while lt p 262144 bound 300000
r = read int 0 zqin p sub 262144 p
if lt r 0
zqbad
end
if eq r 0
break
end
p = add p ulong r
end
put zqn 0 p
put zqp 0 0
while true bound 100000
l = zqtok
if eq l 0
break
end
if eq get zqt 0 35
zqskipl
continue
end
for i ulong l
put zqnm i get zqt i
end
put zqnml 0 l
put zqbusy 0 zqnum
put zqbud 0 zqnum
put zqcon 0 zqnum
put zqfail 0 zqnum
put zqperm 0 zqnum
put zqgenoff 0 zqnum
put zqtokoff 0 zqnum
put zqistat 0 zqnum
put zqtrunc 0 zqnum
put zqmode 0 zqnum
put zqnw 0 zqnum
put zqci 0 zqnum
m = zqnum
for i ulong 65536
put bsevent i 0
end
for i ulong m
w = zqnum
if lt i get zqnw 0
dspp32 add 120 mul i 4 w
end
end
zqexec
end
zqflush
ret 0
end
