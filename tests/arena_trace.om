end
fn atqueue to bool
c = get arcmd 0
s = get arstat 0
for i ulong 262144
v = get arbuf add c i
if ne v get rqcmd i
ret false
end
v = get arbuf add s i
if ne v get rqstat i
ret false
end
end
ret true
end
fn main to int
b = new uchar 1 0
n = read 0 b 0 1
if ne n 1
ret 2
end
m = get b 0
atsetup m
r = arboot 40 128
if lt r 0
ret 3
end
if ne get bstate 0 4
ret 5
end
if ne get rqrx 0 0
ret 5
end
if ne get rqseq 0 0
ret 5
end
if not atqueue
ret 5
end
rqpeer
for i ulong 4096
put rqtmp i 0
end
rqput32 2 40 1
rqput32 2 48 RQVER
rqput32 2 52 RQSIG
rqput32 2 56 32
rqput32 2 60 4097
rqput32 2 32 rqsum 2 80
for i ulong 4096
put rqstat add 4096 i get rqtmp i
end
rqput32 1 16 1
if ne bpoll 1
ret 5
end
if ne get bstate 0 5
ret 5
end
if ne get rqrx 0 1
ret 5
end
if ne get rqseq 0 0
ret 5
end
athput 0 get arused 0
athput 8 get arcmd 0
athput 16 get arstat 0
athput 24 ulong get rqtx 0
athput 32 get arclen 0
athput 40 get artail 0
for i ulong 17
athput add 48 mul i 8 get aroff i
athput add 184 mul i 8 get arsize i
end
for i ulong 4
athput add 320 mul i 8 get arnp i
end
n = write 1 athdr 0 512
if ne n 512
ret 4
end
n = write 1 arbuf 0 get arused 0
if ne n long get arused 0
ret 4
end
n = write 1 arcot 0 1024
if ne n 1024
ret 4
end
ret 0
end
