put arreg 18 0
put arreg 19 0
put arreg 20 3
put arcfg 9 29
put arreg 0 29
put arreg 26 255
put arreg 27 128
put arreg 28 0
if eq mode 4
put arreg 12 3
end
end
if eq mode 10
put arcfg 0 0
end
if eq mode 11
put arbase 0 1048577
end
if eq mode 12
put arcap 0 sub ARMAX 1
put arbase 0 sub not ulong 0 4095
end
if eq mode 13
put arcfg 1 0
end
if eq mode 14
put arcfg 1 65
end
if eq mode 15
put arcfg 2 0
end
if eq mode 16
put arcfg 3 8193
end
if eq mode 17
put arcfg 6 45055
end
if eq mode 18
put arslen 0 0
end
if eq mode 19
put arsrc 1 ARMAX
end
if eq mode 20
put arslen 2 196607
end
if eq mode 21
put arslen 4 47
end
if eq mode 22
put arcap 0 4096
end
if eq mode 23
put arcfg 1 20
end
if eq mode 24
put arcfg 2 sub not ulong 0 4095
end
if eq mode 25
put arused 0 4096
end
if eq mode 26
put arcfg 8 1
end
if eq mode 27
put arcfg 4 shl ulong 1 32
end
if eq mode 28
put arcfg 9 65457
end
if eq mode 29
put arslen 6 383
end
if eq mode 30
