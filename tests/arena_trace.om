fn tpage s ulong pos ulong off ulong n ulong to void
for i ulong n
v = mul add off i 37
v = and add v s 255
put arin add pos i uchar v
end
end
fn tfill s ulong pos ulong to void
n = get arslen s
s = mul add s 1 19
off = ulong 0
for p ulong div n 4096
tpage s pos off 4096
pos = add pos 4096
off = add off 4096
end
tpage s pos off rem n 4096
end
note Independent synthetic caller-owned fixture, never reads actual firmware or a device.
global athdr uchar 512
fn athput o ulong v ulong to void
for i ulong 8
put athdr add o i uchar and shr v mul i 8 255
end
end
fn atsetup mode uchar to void
put arbase 0 1048576
put arcap 0 ARMAX
put arused 0 0
put arcfg 0 1
put arcfg 1 40
put arcfg 2 268435456
put arcfg 3 8192
put arcfg 4 7
put arcfg 5 9
put arcfg 6 45056
put arcfg 7 2560
put arcfg 8 0
put arcfg 9 0
put arslen 0 4097
if eq mode 2
put arslen 0 add mul ulong 512 4096 1
end
put arslen 1 257
put arslen 2 196608
put arslen 3 4103
put arslen 4 48
put arslen 5 384
put arslen 6 384
pos = ulong 0
for s ulong 7
put arsrc s pos
tfill s pos
pos = add pos get arslen s
end
for i ulong 936
put siout i uchar and add mul i 13 129 255
end
if or or eq mode 1 eq mode 3 or eq mode 4 ge mode 30
put arcfg 9 26
put arreg 0 26
put arreg 4 1
put arreg 8 24
put arreg 12 1
put arreg 16 239
put arreg 17 190
put arreg 18 173
put arreg 19 222
put arreg 20 4
put arreg 24 88
end
if or eq mode 3 eq mode 4
