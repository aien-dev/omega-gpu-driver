note HOST ONLY: anonymous queue+BAR mappings, explicit link-time DMA oracle, no device opens.
global qtbytes uchar 65536
fn qck ok bool to void
if not ok
exit 1
end
end
fn qsetup to void
atsetup 0
qck eq arboot 8 128 0
qck eq mmwalloc get arbase 0 get arused 0 MMOK
g = get mmwgen 0
qck eq arstage g MMOK
qck eq mmwdmap g 17 MMOK
qck eq mmwpublish g MMOK
h = mapnew -1 0 2097152 3
qck gt h 0
qck eq gpchip uint 447741952 1
qck eq gpchip uint 0 -95
qck eq qtattach g h 2097152 uint 0 -95
qck eq qtattach g h 2097152 uint 447741952 0
r = mapset h GPNOTIF 4 123
qck eq r 0
rqpeer
r = mapwrite get mmwh 0 get qtstat 0 rqstat 0 32
qck eq r 32
r = mapset get mmwh 0 add get qtstat 0 32 4 rqget32 0 16
qck eq r 0
end
fn qframe f ulong n ulong seq ulong res ulong priv ulong to void
wr = rqget32 1 16
tf f n seq res priv
e = rqget32 2 40
for i ulong e
slot = rem add wr i RQCOUNT
o = mul add slot 1 RQSLOT
r = mapwrite get mmwh 0 add get qtstat 0 o rqstat o RQSLOT
qck eq r long RQSLOT
end
r = mapset get mmwh 0 add get qtstat 0 16 4 rqget32 1 16
qck eq r 0
end
fn qsame wr ulong e ulong to void
for i ulong e
slot = rem add wr i RQCOUNT
o = add get qtcmd 0 mul add slot 1 RQSLOT
r = mapread get mmwh 0 o qtbytes mul i RQSLOT RQSLOT
qck eq r long RQSLOT
end
for i ulong mul e RQSLOT
qck eq get qtbytes i get rqtmp i
end
end
fn qretained to void
qck eq get mmwst 0 MMWQUAR
qck eq mmwclose get qtepoch 0 MMEBUSY
qck ne get mmwh 0 0
qck eq get drunmaps 0 0
qck eq get drdrops 0 0
qck eq breset -10
end
fn main to int
m = new uchar 1 0
qck eq read 0 m 0 1 1
mode = get m 0
qsetup
wr = rqget32 0 16
seq = get rqseq 0
tx = get rqtx 0
if eq mode 105
rqclear 0
qframe 4097 0 0 0 0
qck eq bpoll 1
qck eq get bstate 0 5
rqclear 792
rqput32 4 0 1
rqput32 4 4 2
qck eq bguest 0
qframe 1 792 get bseq 0 0 0
qck eq bpoll 1
qck eq get bstate 0 7
qck eq bstatic 0
qframe 65 128 get bseq 0 0 0
qck eq bpoll 1
qck eq get bstate 0 9
qck eq pasched 1 0 0 8
qck eq brmctrl 123 456 PACMSCH 8 0
rqclear 48
rqput32 4 0 123
rqput32 4 4 456
rqput32 4 8 PACMSCH
rqput32 4 16 8
qframe 76 48 get bseq 0 0 0
qck eq bpoll 1
qck eq get bstate 0 9
qck eq get bresult 0 0
qck eq mapget get mmwh 0 add get qtcmd 0 32 4 4
qck eq get mmwst 0 MMWPUB
ret 0
end
if or eq mode 97 eq mode 119
if eq mode 119
rqput32 0 16 62
r = mapset get mmwh 0 add get qtcmd 0 16 4 62
qck eq r 0
r = mapset get mmwh 0 add get qtstat 0 32 4 20
qck eq r 0
wr = 62
end
n = ulong 17
if eq mode 119
n = 4020
end
rqclear n
put rqpay 0 91
qck eq qtsend 76 n n true 0
qsame wr div add add 80 n 4095 4096
qck eq mapget get mmwh 0 add get qtcmd 0 16 4 rqget32 0 16
qck eq mapget get qtbar 0 GPNOTIF 4 0
qck eq get rqseq 0 add seq uint 1
qck eq get rqtx 0 add tx uint 1
qck eq rqcommit get rqptok 0 -6
ret 0
end
if eq mode 102
r = mapset get mmwh 0 add get qtstat 0 32 4 rem add wr 1 RQCOUNT
qck eq r 0
qck eq qtsend 76 0 0 true -2
qck eq rqget32 0 16 wr
qck eq get rqseq 0 seq
qck eq get rqtx 0 tx
qck eq mapget get qtbar 0 GPNOTIF 4 123
qck eq get mmwst 0 MMWPUB
ret 0
end
if eq mode 112
qck eq qtsend 76 0 0 true -6
qck eq mapget get mmwh 0 add get qtcmd 0 16 4 rem add wr 1 RQCOUNT
qck eq get rqseq 0 add seq uint 1
qretained
ret 0
end
if eq mode 103
put bgen 0 add get bgen 0 1
qck eq qtsend 76 0 0 true -6
qck eq get rqseq 0 seq
qck eq mapget get qtbar 0 GPNOTIF 4 123
ret 0
end
if eq mode 98
qck eq breset -10
ret 0
end
if eq mode 120
put bbudget 0 1
qck eq bpoll 0
qck eq bpoll -11
qretained
ret 0
end
if eq mode 118
r = mapset get mmwh 0 add get qtstat 0 20 4 0
qck eq r 0
qck eq qtsend 76 0 0 true -1
qck eq get rqseq 0 seq
qretained
ret 0
end
if eq mode 101
rqclear 4
qframe 72 4 0 0 0
qck eq bpoll -13
qck eq mapget get mmwh 0 add get qtcmd 0 32 4 1
qretained
ret 0
end
if eq mode 114
rqput32 0 32 62
rqput32 1 16 62
r = mapset get mmwh 0 add get qtcmd 0 32 4 62
qck eq r 0
r = mapset get mmwh 0 add get qtstat 0 16 4 62
qck eq r 0
rqclear 4020
put rqpay 4019 91
qframe 76 4020 0 0 0
qck eq bpull 1
qck eq get rqout 4099 91
qck eq mapget get mmwh 0 add get qtcmd 0 32 4 1
ret 0
end
rqclear 1
qframe 76 1 0 0 0
if eq mode 99
r = mapset get mmwh 0 add add get qtstat 0 RQSLOT 80 4 256
qck eq r 0
end
if eq mode 109
r = mapset get mmwh 0 add add get qtstat 0 RQSLOT 40 4 2
qck eq r 0
end
if eq mode 104
r = mapset get mmwh 0 add get qtstat 0 20 4 0
qck eq r 0
end
qck eq qtsnap 0
token = get qttok 0
if eq mode 116
qck eq qtaccept add token 1 -6
qck eq mapget get mmwh 0 add get qtcmd 0 32 4 0
end
if eq mode 115
r = mapset get mmwh 0 add get qtstat 0 16 4 2
qck eq r 0
end
if or eq mode 116 eq mode 115
qck eq qtaccept token 1
qck eq rqget32 1 16 1
qck eq mapget get mmwh 0 add get qtcmd 0 32 4 1
qck eq qtaccept token -6
ret 0
end
expected = long -1
if eq mode 99
expected = -3
end
qck eq qtaccept token expected
qck eq mapget get mmwh 0 add get qtcmd 0 32 4 0
qck eq get rqrx 0 uint 0
qretained
ret 0
end
