pos = add pos sz
end
end
ret eq pos n
end
note Dynamic for loops have compiler fuel1000000; page chunks cover the full declared16MiB bound.
fn arzero o ulong n ulong to void
for p ulong div n 4096
for i ulong 4096
put arbuf add o i 0
end
o = add o 4096
end
for i ulong rem n 4096
put arbuf add o i 0
end
end
fn arcspan d ulong s ulong n ulong to void
for i ulong n
v = get arin add s i
put arbuf add d i v
end
end
fn artake k ulong n ulong to bool
sz = and add n 4095 not ulong 4095
u = get arused 0
if or lt sz n gt u get arcap 0
ret false
end
if gt sz sub get arcap 0 u
ret false
end
put aroff k u
put arsize k n
put arused 0 add u sz
arzero u sz
ret true
end
fn arcopy k ulong s ulong to void
n = get arslen s
k = get aroff k
s = get arsrc s
for p ulong div n 4096
arcspan k s 4096
k = add k 4096
s = add s 4096
end
arcspan k s rem n 4096
end
fn araddr k ulong to ulong
ret add get arbase 0 get aroff k
end
fn ardma pa ulong n ulong to bool
b = get arcfg 1
if gt n sub not ulong 0 pa
ret false
end
if eq b 64
ret true
end
lim = shl ulong 1 b
if ge pa lim
ret false
end
ret le n sub lim pa
end
fn arlogpt k ulong to void
n = div get arsize k 4096
a = araddr k
k = get aroff k
for j ulong n
o = add k 8
o = add o mul j 8
v = add a mul j 4096
arput o v 8
end
end
fn arlogs to void
pos = ulong 0
for i ulong 8
id = ulong 0
while ne get arnames pos 124 bound 8
id = or shl id 8 ulong get arnames pos
pos = add pos 1
