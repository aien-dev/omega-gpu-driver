note Host-only physical image composer, never DMA/MMIO. Oracle a108b114 gb10_gsp_boot.c:367-553.
note Profile 1 means explicit UNVERIFIED GB10B 580.173.02 layout, NOT detected hardware identity.
note Vendor 20e4e6e kernel_sec2_gb10b.c:507-508: gspFmcSysmemOffset = memdescGetPhysAddr; frtsSysmemSize = pGspImageSize.
note WolframLanguageEvaluator FromDigits[dc3aae21371a60b3,16] -> 15869187694674993331; FromDigits[1410de7e,16] -> 336649854.
note Caller supplies arin bytes and arsrc/arslen spans: ELF,RMsignature,bootloader,FMC,hash,key,FMCsignature.
note No firmware parsing/authentication: signed-byte fixtures test composition only, not signature validity.
note arcfg: profile,dmaBits,heapPA,heapBytes,gpuInstance,regkeys,BLcode,BLdata,BLmanifest,registryBytes.
note arbase is caller supplied IOVA. arcap <=16MiB; arused must be zero on entry. Partial output invalid on failure.
note aroff/arsize: WPR,libos,7 logs,args,shared,radix,BL,signature,FMC,FMCargs,ELFdata.
note arcmd/arstat are queue byte offsets. arcot[0..arclen) is SEC2 packet; artail is EMEM queue tail.
note Raw registry must be canonical PACKED_REGISTRY_TABLE: 1..32 entries, exact contiguous name/value order,
note nonempty terminated names, type1 DWORD length4 or type2/3 nonempty bytes, reserved padding zero.
note Strings preserve opaque bytes like C oracle; their termination is not reinterpreted. Zero bytes omits RPC73.
note Refusals: -1 profile/config, -2 source spans, -3 capacity, -4 registry, -5 DMA, -6 queue.
const ARMAX ulong 16777216
global arbuf uchar 16777216
global arin uchar 16777216
global arreg uchar 65456
global arsrc ulong 7
global arslen ulong 7
global arcfg ulong 10
note arpkg: signature-family, boot-archive, FMC-archive source profiles; 2 means gb20y/GB20B.
note These are caller assertions, not signature authentication or hardware admission.
global arpkg ulong 3
global arbase ulong 1
global arcap ulong 1
global arused ulong 1
global aroff ulong 17
global arsize ulong 17
global arcmd ulong 1
global arstat ulong 1
global arcot uchar 1024
global arclen ulong 1
global artail ulong 1
global arnp ulong 4
global arlvl ulong 4
text arnames "LOGINIT|LOGINTR|LOGRM|LOGMNOC|LOGDBG|LOGROOT|LOGKRNL|RMARGS|"
fn arput o ulong v ulong n ulong to void
for i ulong n
put arbuf add o i uchar and shr v mul i 8 255
end
end
fn arcput o ulong v ulong n ulong to void
for i ulong n
put arcot add o i uchar and shr v mul i 8 255
end
end
fn arreg32 o ulong to ulong
v = ulong 0
for i ulong 4
v = or v shl ulong get arreg add o i mul i 8
end
ret v
end
fn arregok to bool
n = get arcfg 9
if eq n 0
ret true
end
if or lt n 8 gt n 65456
ret false
end
if ne arreg32 0 n
ret false
end
cnt = arreg32 4
if or eq cnt 0 gt cnt 32
ret false
end
pos = add 8 mul cnt 16
if gt pos n
ret false
end
for i ulong cnt
e = add 8 mul i 16
if ne arreg32 e pos
ret false
end
if ge pos n
ret false
end
if eq get arreg pos 0
ret false
end
while lt pos n bound 65456
if eq get arreg pos 0
break
end
pos = add pos 1
end
if ge pos n
ret false
end
pos = add pos 1
for j ulong 3
if ne get arreg add e add 5 j 0
ret false
end
end
t = get arreg add e 4
sz = arreg32 add e 12
if eq t 1
if ne sz 4
ret false
